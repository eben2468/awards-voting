# Copy this file to .env and fill in the real values.
# .env is ignored by git, so it must be created by hand on each server.
# Wrap a value in double quotes if it contains spaces.

# Database
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Nalo SMS and USSD
NALO_SMS_KEY=
NALO_SMS_SENDER_ID=VOTEHUBGH
NALO_USER_ID=

# Nalo Pay
NALO_PAY_MERCHANT_ID=
NALO_PAY_SECRET_KEY=
NALO_PAY_BASIC_AUTH="Basic your-token-here"

# Only needed if a cron job calls the URL instead of running PHP directly
CRON_KEY=
